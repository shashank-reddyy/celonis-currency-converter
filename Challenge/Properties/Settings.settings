<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="Challenge.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
