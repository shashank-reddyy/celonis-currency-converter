<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Challenge.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <applicationSettings>
    <Challenge.Properties.Settings>
      <!-- Cache eviction strategy for historic rate queries: "TimeBased" or "SizeBased". -->
      <setting name="CacheEvictionStrategy" serializeAs="String">
        <value>TimeBased</value>
      </setting>
      <!-- MAX_AGE: TimeBased removes every cached element older than this many minutes. -->
      <setting name="CacheMaxAgeMinutes" serializeAs="String">
        <value>10</value>
      </setting>
      <!-- MAX_ELEMENTS: SizeBased removes the oldest element once the cache holds more elements than this. -->
      <setting name="CacheMaxElements" serializeAs="String">
        <value>20</value>
      </setting>
    </Challenge.Properties.Settings>
  </applicationSettings>
</configuration>
